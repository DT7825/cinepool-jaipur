# Network settings used by `npm run dev` and `npm run preview`.
HOST=0.0.0.0
PORT=5173

# Backend base URL for the Java Spring Boot API.
VITE_API_BASE_URL=http://localhost:8080

# Clerk frontend publishable key (public; safe to expose in the browser).
# Copy this from Clerk Dashboard > API Keys. Never put a secret key here.
VITE_CLERK_PUBLISHABLE_KEY=
