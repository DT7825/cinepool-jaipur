# Example values only. Spring Boot does not automatically read this file.
# Set these variables in the PowerShell window used to start the backend.
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local MySQL database. The MySQL server must be running and the schema and
# least-privilege application user must already exist. Keep the real password
# in your environment or a private, ignored .env file; never commit it.
DATABASE_URL=jdbc:mysql://localhost:3306/picturehouse?serverTimezone=UTC
DATABASE_USER=picturehouse_app
DATABASE_PASSWORD=replace_with_the_password_you_set_for_picturehouse_app
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver

# Optional email-ticket delivery. Use credentials from an SMTP mail provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-app-password
TICKET_EMAIL_FROM=tickets@example.com

# Clerk user IDs allowed to approve theatre-owner access requests.
ADMIN_CLERK_USER_IDS=user_replace_with_clerk_user_id

# Copy Razorpay TEST credentials from the Test Mode dashboard.
# Keep the secret on the backend. Never put it in VITE_* or React files.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me_with_test_secret
